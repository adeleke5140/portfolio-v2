---
import { cn } from '@/lib/utils'

// MDX passes `className` (JSX), Astro templates pass `class`.
interface Props {
  class?: string
  className?: string
}

const { class: classAttr, className } = Astro.props
---

<div
  class={cn(
    'bg-gray-100/50 relative grid place-items-center dark:bg-[#1c1c1c] min-h-[264px] dark:border-[#282828] border-[0.5px] rounded-xl w-full p-2 py-8',
    classAttr ?? className
  )}
>
  <slot />
</div>
