---
import PageWrapper from '@/components/PageWrapper.astro'
import { formatDate } from '@/helpers/formatDate'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getPosts, groupPostsByYear } from '@/lib/content'

const postsByYear = groupPostsByYear(await getPosts())
---

<BaseLayout
  title="Blog"
  description="Kehinde Adeleke's blog page where he writes technical articles"
>
  <PageWrapper heading="Blog">
    <section class="flex flex-col">
      {
        postsByYear.map(([year, posts]) => (
          <div class=" last:border-b-0 pt-10 first:pt-0 border-b-[0.5px] border-b-[#dcdcdc]">
            <p class="text-sm mb-4 text-ken-grey">{year}</p>
            <div>
              {posts.map((post) => (
                <a
                  href={`/blog/${post.id}`}
                  class="group rounded-md py-2 block mb-2 transition-colors duration-200"
                >
                  <div class="flex text-base md:flex-row md:justify-between group-hover:translate-x-2 flex-col gap-1 transition-transform">
                    <p class="hover:underline transition-all">{post.data.title}</p>
                    <span class="text-xs text-ken-grey">
                      {formatDate(post.data.date, 'LLL d, yyyy')}
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </section>
  </PageWrapper>
</BaseLayout>
